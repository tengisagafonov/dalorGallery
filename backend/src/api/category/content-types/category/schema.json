{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Kategorie",
    "description": "Gruppiert zusammengehörige Galerie-Vorlagen"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "nameDe": { "type": "string" },
    "nameRu": { "type": "string" },
    "nameHi": { "type": "string" },
    "namePa": { "type": "string" },
    "autoTranslate": {
      "type": "boolean",
      "default": false
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "descriptionDe": { "type": "text" },
    "descriptionRu": { "type": "text" },
    "descriptionHi": { "type": "text" },
    "descriptionPa": { "type": "text" },
    "parentCategory": {
      "type": "string"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "parent"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "templates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::template.template",
      "mappedBy": "category"
    },
    "subcategoryTemplates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::template.template",
      "mappedBy": "subcategory"
    }
  }
}
