{
  "kind": "collectionType",
  "collectionName": "templates",
  "info": {
    "singularName": "template",
    "pluralName": "templates",
    "displayName": "Vorlage",
    "description": "Eine anpassbare Prompt-Vorlage für Dalor Gallery"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "legacyId": {
      "type": "integer",
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "titleDe": { "type": "string" },
    "descriptionDe": { "type": "text" },
    "titleRu": { "type": "string" },
    "descriptionRu": { "type": "text" },
    "titleHi": { "type": "string" },
    "descriptionHi": { "type": "text" },
    "titlePa": { "type": "string" },
    "descriptionPa": { "type": "text" },
    "autoTranslate": {
      "type": "boolean",
      "default": false
    },
    "prompt": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "templates"
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "subcategoryTemplates"
    },
    "eyebrow": { "type": "string" },
    "headline": { "type": "string" },
    "subline": { "type": "string" },
    "style": { "type": "text" },
    "coverFit": {
      "type": "enumeration",
      "enum": ["cover", "contain"],
      "default": "cover"
    },
    "inputFields": {
      "type": "component",
      "component": "template.input-field",
      "repeatable": true
    },
    "searchKeywords": {
      "type": "json"
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "isTrending": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0
    }
  }
}
